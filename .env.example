# DRIVEAM — plantilla de variables de entorno.
# Copia este archivo a `.env` y ajusta los valores. `.env` NUNCA se versiona.

# ------------------------------------------------------------------
# Django
# ------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.local
# Genera una para local con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ------------------------------------------------------------------
# Base de datos (PostgreSQL)
# ------------------------------------------------------------------
POSTGRES_DB=driveam
POSTGRES_USER=driveam
POSTGRES_PASSWORD=driveam
# El backend lee DATABASE_URL; el servicio `db` de Docker usa las POSTGRES_*.
DATABASE_URL=postgres://driveam:driveam@db:5432/driveam

# ------------------------------------------------------------------
# CORS (orígenes permitidos para llamar a la API, separados por comas)
# ------------------------------------------------------------------
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------
# Frontend (Next.js)
# ------------------------------------------------------------------
# URL de la API accesible desde el navegador del usuario.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# URL de la API accesible desde el contenedor de Next (Server Components).
API_BASE_URL_INTERNAL=http://backend:8000

# ------------------------------------------------------------------
# Windows + OneDrive: descomenta si el hot-reload no detecta cambios
# en los archivos montados por bind mount.
# ------------------------------------------------------------------
# WATCHPACK_POLLING=true
# CHOKIDAR_USEPOLLING=true
